# Salin menjadi .env:  cp env.example .env

# --- Kredensial (samakan dengan DB_USER/DB_PASSWORD/DB_NAME di server aplikasi)
POSTGRES_USER=mojo_db_user
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=mojo_db

# --- Jaringan
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432

# --- Image & lokasi data
TIMESCALE_IMAGE=timescale/timescaledb:2.17.2-pg16
PGDATA_DIR=./data/postgres
TZ=Asia/Jakarta

# --- Resource
# Container TIDAK dibatasi CPU/RAM; memakai seluruh resource VM database.
# timescaledb-tune (saat init pertama) mendeteksi RAM & CPU VM otomatis.
# Isi hanya jika ingin tuning untuk ukuran tertentu, contoh: 32GB / 8
TS_TUNE_MEMORY=
TS_TUNE_NUM_CPUS=
DB_MAX_CONNECTIONS=300
DB_SHM_SIZE=1g

# Query yang lebih lama dari ini (ms) dicatat di log
DB_LOG_SLOW_MS=2000
