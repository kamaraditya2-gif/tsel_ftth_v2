# Database Configuration
POSTGRES_USER=mojojojo_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION
POSTGRES_DB=mojojojo_database
DB_HOST=mojojojo_postgres
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD_IN_PRODUCTION
REDIS_HOST=mojojojo_redis
REDIS_PORT=6379

# Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost/api
INTERNAL_API_URL=http://localhost:3000

# Timezone
TZ=Asia/Jakarta

# Production Settings
NODE_ENV=production

# Nginx (opsional, hanya jika pakai docker-compose-nginx.yml)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
