# ============================================
# Mojo-Central - Environment Configuration
# ============================================
# Copy file ini ke .env dan isi password asli.
# .env tidak akan di-commit ke git (gitignored).

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
POSTGRES_USER=mojo_db_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION
POSTGRES_DB=mojo_db
POSTGRES_PORT=5432

DB_HOST=mojo-db
DB_PORT=5432
DB_USER=mojo_db_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION        # WAJIB sama dengan POSTGRES_PASSWORD
DB_NAME=mojo_db

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_HOST=mojo-redis
REDIS_PORT=6379
REDIS_PORT_INTERNAL=6379
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD_IN_PRODUCTION

# ------------------------------------------------------------------
# Dashboard (Next.js)
# ------------------------------------------------------------------
DASHBOARD_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost/api
INTERNAL_API_URL=http://localhost:3000
SESSION_SECRET=CHANGE_THIS_RANDOM_SECRET_STRING
TZ=Asia/Jakarta
NODE_ENV=production
# Token untuk server mojo-edge (regional) yang mengirim data ke /api/edge/* (Authorization: Bearer <token>).
# Kosong = semua request edge ditolak. Buat dengan: openssl rand -hex 32
EDGE_SYNC_TOKEN=

# ------------------------------------------------------------------
# Worker & Dispatcher
# ------------------------------------------------------------------
API_BASE_URL=http://mojo-central-dashboard:3000         # URL ke dashboard API dari worker
PING_RATE_LIMIT_SECONDS=10                           # jeda antar ping per device (detik)
SPEED_RATE_LIMIT_SECONDS=10                          # jeda antar speed test per device (detik)
AXIROS_CONFIG_TTL_MS=60000                           # TTL cache konfig Axiros (ms)

# ------------------------------------------------------------------
# Direct Ping Worker (Regional)
# ------------------------------------------------------------------
DIRECT_PING_INTERVAL_MINUTES=10                      # interval ping dari server ke device (menit)
DOWNSTREAM_SERVER_ID=1                               # ID region (0=all, 1=Pusat, 2=SUMUT, dst)

# ------------------------------------------------------------------
# Optional: AI Integrations (Gemini)
# ------------------------------------------------------------------
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=

# ------------------------------------------------------------------
# Optional: Nginx
# ------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
