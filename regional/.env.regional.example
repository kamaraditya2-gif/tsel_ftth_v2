# =============================================================================
# Regional Direct Ping Worker — Environment Variables
# =============================================================================
# Copy file ini ke .env di server regional, lalu edit nilainya.
#   cp .env.regional.example .env
#   nano .env
# =============================================================================

# Koneksi Database Pusat
DB_HOST=103.143.12.115
DB_PORT=5432
DB_USER=mojo_db_user
DB_PASSWORD=QG4CXVN4jbTKrjvdiiEjihOO
DB_NAME=mojo_db

# Regional Identity
# ID=1 untuk VM pusat (ping semua device)
# ID=2 untuk SUMUT
# ID=3 untuk JATENG
# ID=4 untuk JATIM
# ID=5 untuk KALIMANTAN
# ID=6 untuk SULAWESI
# (dst, sesuaikan dengan isi tabel downstream_servers)
DOWNSTREAM_SERVER_ID=2

# Interval & Batch
INTERVAL=10              # menit antar siklus fping
BATCH=500                # jumlah device per batch fping
